# Copie para o servidor como /opt/vox-script-salux/.env
# cp server.env.example .env && nano .env

DOCKERHUB_USER=geansilvalima
IMAGE_TAG=latest

# Site acessível em http://179.188.193.186
WEB_PORT=80

MASTER_USERNAME=master
MASTER_PASSWORD=troque-por-uma-senha-forte
AUTH_SECRET=troque-por-um-segredo-aleatorio-longo

# Autenticação e scripts ficam em SQLite no volume Docker persistente.
# O Oracle XE local não é iniciado no perfil de produção de 1 GB.
# A pré-validação Oracle fica desativada, a menos que você configure uma base Oracle externa.

# Oracle externo opcional (Easy Connect). Descomente e preencha se disponível:
# ORACLE_EXTERNAL_USER=usuario
# ORACLE_EXTERNAL_PASSWORD=senha
# ORACLE_EXTERNAL_CONNECTION_MODE=connect_string
# ORACLE_EXTERNAL_CONNECT_STRING=host-oracle:1521/servico

# --- Oracle Secundário (opcional — para comparar duas bases distintas) ---
# ORACLE_COMPARE_USER=usuario
# ORACLE_COMPARE_PASSWORD=senha
# ORACLE_COMPARE_CONNECTION_MODE=connect_string
# ORACLE_COMPARE_CONNECT_STRING=outro-host:1521/servico
