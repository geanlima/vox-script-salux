# Docker Hub (obrigatório para publicar e fazer deploy no servidor)
DOCKERHUB_USER=geansilvalima
IMAGE_TAG=latest

# Portas (local: 8080 evita conflito com IIS/outros serviços na 80)
WEB_PORT=8080
API_PORT=3000

# Porta publicada do Oracle no host (docker compose: ${ORACLE_PORT}:1521)
# Use 1522 se a 1521 já estiver ocupada por outro Oracle local
ORACLE_PORT=1522

# Oracle dedicado à pré-validação (padrão do docker-compose)
ORACLE_USER=validator
ORACLE_PASSWORD=ValidatorPass1
ORACLE_ADMIN_PASSWORD=ValidatorAdmin1

# --- Conexão Oracle Principal (escolha UM modo) ---

# Desenvolvimento local (npm run start:api + ng serve): Oracle do container via localhost
ORACLE_CONNECTION_MODE=easy_connect
ORACLE_HOST=localhost
ORACLE_SERVICE_NAME=XEPDB1

# Modo 1 alternativo: Connection String explícita
# ORACLE_CONNECTION_MODE=connect_string
# ORACLE_CONNECT_STRING=localhost:1522/XEPDB1

# Modo 2: TNS (alias do tnsnames.ora)
# ORACLE_CONNECTION_MODE=tns
# ORACLE_TNS_NAME=MEU_ALIAS
# ORACLE_TNS_ADMIN=/opt/oracle/network/admin

# Modo 3: Easy Connect (host + porta + service/SID)
# ORACLE_CONNECTION_MODE=easy_connect
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=XEPDB1

# Para usar um Oracle externo em vez do container:
# ORACLE_CONNECT_STRING=ip-externo:1521/servico

# INI Salux — lista ServerName (TNS) da seção [Database] na tela Comparar
# SALUX_INI_PATH=C:\Salux\Projetos\Portal\2605\PBL\arquivo.ini

# TNS local — usado no modo "TNS da máquina" (npm run start:api na sua máquina)
# Aponta para a pasta do tnsnames.ora (mesma do SQL Developer / Oracle Client)
# ORACLE_TNS_ADMIN=C:\oracle\network\admin
# TNS_ADMIN=C:\oracle\network\admin
# ORACLE_HOME=C:\app\client\product\19.0.0\client_1

# --- Oracle Secundário (opcional — comparação entre bases) ---
# ORACLE_COMPARE_USER=usuario
# ORACLE_COMPARE_PASSWORD=senha
# ORACLE_COMPARE_CONNECTION_MODE=tns
# ORACLE_COMPARE_TNS_NAME=OUTRO_ALIAS

MASTER_USERNAME=master
MASTER_PASSWORD=master@123
AUTH_SECRET=defina-um-segredo-em-producao
